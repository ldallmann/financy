# Segredo usado para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=

# Caminho do banco SQLite (relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"

# Porta HTTP da API (opcional, padrão 4000)
PORT=4000

# Origem permitida no CORS (opcional; padrão: qualquer origem)
CORS_ORIGIN=http://localhost:5173
